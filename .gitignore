# ==============================================================================
# Security & Git Exclusion Policy: DisputeMind AI
# STRICT: Keep all secrets, passwords, credentials, databases and backups off Git!
# ==============================================================================

# 1. Environment & API Keys (Item 1 & 2)
.env
.env.*
!.env.example
*.env.local
*.env.production

# 2. Database Files & Locks (Item 10)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 3. Automated Database Backups (Item 11)
backups/
*.backup
*.dump
*.sql

# 4. Certificates, Keys & Secrets (Item 8)
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# 5. Python & Bytecode (Item 15)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 6. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 7. Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# 8. Node & Frontend (for future frontend)
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 9. IDE & OS Metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

