# ==============================================================================
# Evidentia — Environment Variables Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL!
# ==============================================================================

# Application Runtime & Security
ENVIRONMENT=production          # "development" or "production"
DEBUG=false                     # Item 12: Disable debug mode in production (hide docs & traces)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["https://Evidentia.onrender.com","http://localhost:5173"]

# Security & Authentication (Item 1, 4, 8, 9)
# Generate a secure 64-character hex key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting (Item 7: Stop Login Spam)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_WEBHOOK_PER_MINUTE=100
RATE_LIMIT_GLOBAL_PER_MINUTE=60

# Database & Storage (Item 10 & 11)
DATABASE_URL=sqlite:///./Evidentia.db
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# PayPal Sandbox API (Mandatory Hackathon Integration)
PAYPAL_MODE=sandbox             # "sandbox" or "live"
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Google Gemini AI (Item 1: Mandatory AI Synthesis Engine)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Elastic Search (Sponsor Tool)
# For Elastic Cloud, provide Cloud ID + API Key; for local fallback, leave empty
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your_elastic_api_key_here
ELASTICSEARCH_INDEX_PREFIX=Evidentia_

